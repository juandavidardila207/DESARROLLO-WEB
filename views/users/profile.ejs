<section class="profile-section">
  <div class="profile-container">

    <div class="profile-card">
      <div class="profile-avatar-wrap">
        <% if (user.profileImage) { %>
          <img src="<%= user.profileImage %>" alt="Foto de perfil de <%= user.firstName %>" class="profile-avatar">
        <% } else { %>
          <div class="profile-avatar-placeholder">
            <%= user.firstName.charAt(0).toUpperCase() %><%= user.lastName.charAt(0).toUpperCase() %>
          </div>
        <% } %>
      </div>

      <div class="profile-info">
        <h1 class="profile-name"><%= user.firstName %> <%= user.lastName %></h1>
        <span class="profile-badge profile-badge--<%= user.category %>"><%= user.category %></span>
      </div>

      <div class="profile-details">
        <div class="profile-detail-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          <span><%= user.email %></span>
        </div>
        <% if (user.phone) { %>
          <div class="profile-detail-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.58 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span><%= user.phone %></span>
          </div>
        <% } %>
        <div class="profile-detail-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span>Miembro desde <%= new Date(user.createdAt).toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
        </div>
      </div>

      <div class="profile-actions">
        <a href="/" class="btn-secondary">Seguir comprando</a>
        <form action="/usuarios/logout" method="POST" style="display:inline;">
          <button type="submit" class="btn-logout">Cerrar sesión</button>
        </form>
      </div>
    </div>

  </div>
</section>
