<section class="auth-section">
  <div class="auth-container">
    <div class="auth-card auth-card--centered">

      <% if (success) { %>
        <!-- ✅ Éxito -->
        <div class="verify-icon verify-icon--success">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
        </div>
        <h1 class="auth-title">
          <% if (alreadyVerified) { %>
            Ya estabas verificado
          <% } else { %>
            ¡Cuenta verificada!
          <% } %>
        </h1>
        <p class="auth-subtitle">
          <% if (alreadyVerified) { %>
            Tu cuenta ya estaba activa, <%= firstName %>. Podés iniciar sesión directamente.
          <% } else { %>
            Bienvenid@ a PC Componentes, <strong><%= firstName %></strong>. 
            Tu cuenta ya está activa y podés empezar a comprar.
          <% } %>
        </p>
        <a href="/usuarios/login" class="btn-primary btn-full" style="margin-top:24px">
          Iniciar sesión
        </a>

      <% } else { %>
        <!-- ❌ Error -->
        <div class="verify-icon verify-icon--error">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="15" y1="9" x2="9" y2="15"></line>
            <line x1="9" y1="9" x2="15" y2="15"></line>
          </svg>
        </div>
        <h1 class="auth-title">Enlace inválido</h1>
        <p class="auth-subtitle"><%= reason %></p>

        <% if (typeof expiredEmail !== 'undefined') { %>
          <form action="/usuarios/reenviar-verificacion" method="POST" style="margin-top:20px">
            <input type="hidden" name="email" value="<%= expiredEmail %>">
            <button type="submit" class="btn-primary btn-full">
              Reenviar correo de verificación
            </button>
          </form>
        <% } %>

        <div class="auth-divider"><span>o</span></div>
        <a href="/usuarios/registro" class="btn-secondary btn-full">Crear cuenta nueva</a>

      <% } %>

    </div>
  </div>
</section>
